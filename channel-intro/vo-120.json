  {
   "t": 0.7,
   "text": "वोकल फ़ॉर सनातन।"
  },
  {
   "t": 4.3,
   "text": "दुकान नहीं है?"
  },
  {
   "t": 5.75,
   "text": "दुकान हो या न हो… भरोसा पूरा है।"
  },
  {
   "t": 8.6,
   "text": "हुनर है… पर पहचान नहीं।"
  },
  {
   "t": 11.6,
   "text": "ज़रूरत है… पर भरोसेमंद कौन?"
  },
  {
   "t": 15.1,
   "text": "एक तरफ़ ग्राहक की तलाश… दूसरी तरफ़ कारीगर का इंतज़ार।"
  },
  {
   "t": 19.6,
   "text": "पेश है… वोकल फ़ॉर सनातन। एक ऐप, जो अपनों को, अपनों से जोड़े।"
  },
  {
   "t": 26.5,
   "text": "आपके पास… आपके अपने।"
  },
  {
   "t": 30.1,
   "text": "एक कहानी… रात के नौ बजे, घर की बिजली गुल।"
  },
  {
   "t": 33.9,
   "text": "शर्मा जी ने ऐप खोला… इलेक्ट्रीशियन मिला।",
   "speed": 1.05
  },
  {
   "t": 37.0,
   "text": "रमेश भाई को… नया ग्राहक।"
  },
  {
   "t": 38.9,
   "text": "काम भी हुआ… और रिश्ता भी बना।"
  },
  {
   "t": 41.6,
   "text": "यही है… अपनों का साथ।"
  },
  {
   "t": 45.3,
   "text": "ग्राहकों के लिए…"
  },
  {
   "t": 47.4,
   "text": "अपने आस-पास की सर्विस और दुकानें खोजें।"
  },
  {
   "t": 50.6,
   "text": "प्रोफ़ाइल, सर्विस और समय देखें।"
  },
  {
   "t": 53.0,
   "text": "और सीधे अपने इलाके के कारीगर से जुड़ें।"
  },
  {
   "t": 56.4,
   "text": "बिज़नेस या सर्विस प्रोवाइडर हैं?"
  },
  {
   "t": 59.5,
   "text": "रजिस्टर करें, प्रोडक्ट या सर्विस चुनें।"
  },
  {
   "t": 61.9,
   "text": "अपनी प्रोफ़ाइल बनाइए।"
  },
  {
   "t": 63.9,
   "text": "और ग्राहक पाइए, सीधे अपने इलाके से।"
  },
  {
   "t": 67.6,
   "text": "क्यों वोकल फ़ॉर सनातन?"
  },
  {
   "t": 69.4,
   "text": "अपना इलाका, पास की मदद।",
   "speed": 1.1
